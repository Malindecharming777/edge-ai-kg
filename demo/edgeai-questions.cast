[20.702331, "o", "\u001b[38;5;59m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(op:Operator)<-[:USES_OPERATOR]-(m:Model)<-[:VARIANT_OF]-(v:ModelVariant)                  \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m      \u001b[0m<-[:OF_VARIANT]-(d:Deployment)-[:ON_BOARD]->(b:Board)                                      \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWHERE\u001b[0m\u001b[90m \u001b[0mop.name\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[33m\"Conv\"\u001b[0m\u001b[90m \u001b[0mAND\u001b[90m \u001b[0md.fits\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[94m1\u001b[0m                                                            \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mRETURN\u001b[0m\u001b[90m \u001b[0mop.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0moperator,\u001b[90m \u001b[0mcount(\u001b[94mDISTINCT\u001b[0m\u001b[90m \u001b[0md.id)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mdeployments_at_risk,                         \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m       \u001b[0mcount(\u001b[94mDISTINCT\u001b[0m\u001b[90m \u001b[0mb.id)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mboards_affected,\u001b[90m \u001b[0mcount(\u001b[94mDISTINCT\u001b[0m\u001b[90m \u001b[0mm.id)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mmodels_affected          \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
