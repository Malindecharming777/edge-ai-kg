[6.989969, "o", "\u001b[1;35moperator             \u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mcategory     \u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mmodels_using\u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mkernel_count\u001b[0m\r\nAsinh                  elementwise    1             79          \r\nRotaryEmbedding        attention      5             79          \r\nHardSigmoid            activation     7             79          \r\nReshape                shape          3             79          \r\nInstanceNormalization  normalization  13            79          \r\nAcos                   elementwise    6             79          \r\n"]
