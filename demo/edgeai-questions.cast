[2.616723, "o", "\u001b[38;5;59m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(m:Model)-[:USES_OPERATOR]->(op:Operator)                                                  \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWHERE\u001b[0m\u001b[90m \u001b[0mm.id\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[33m\"model:00000\"\u001b[0m                                                                       \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mOPTIONAL\u001b[0m\u001b[90m \u001b[0m\u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(k:Kernel)-[:IMPLEMENTS]->(op),\u001b[90m \u001b[0m(k)-[:RUNS_ON]->(a:Accelerator)                   \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWHERE\u001b[0m\u001b[90m \u001b[0ma.id\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[33m\"accel:00001\"\u001b[0m                                                                       \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWITH\u001b[0m\u001b[90m \u001b[0mop,\u001b[90m \u001b[0mcount(k)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mkernels                                                                     \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWHERE\u001b[0m\u001b[90m \u001b[0mkernels\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[94m0\u001b[0m                                                                                \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWITH\u001b[0m\u001b[90m \u001b[0mop.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0moperator,\u001b[90m \u001b[0mop.category\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mcategory,\u001b[90m \u001b[0mop.since_version\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mopset                     \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mRETURN\u001b[0m\u001b[90m \u001b[0moperator,\u001b[90m \u001b[0mcategory,\u001b[90m \u001b[0mopset                                                                 \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mORDER\u001b[0m\u001b[90m \u001b[0m\u001b[94mBY\u001b[0m\u001b[90m \u001b[0mcategory                                                                                \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[3.349063, "o", "\u001b[1;35moperator     \u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mcategory   \u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mopset\u001b[0m\r\nCelu           activation   28   \r\nElu            activation   22   \r\nHardSwish      activation   22   \r\nConvTranspose  convolution  22   \r\nCol2Im         convolution  18   \r\nBitwiseXor     elementwise  18   \r\n"]
