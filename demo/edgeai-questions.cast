[38.979796, "o", "\u001b[38;5;59m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(m:Model)-[:USES_OPERATOR]->(op:Operator)                                                  \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mOPTIONAL\u001b[0m\u001b[90m \u001b[0m\u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(k:Kernel)-[:IMPLEMENTS]->(op),\u001b[90m \u001b[0m(k)-[:RUNS_ON]->(a:Accelerator)                   \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWHERE\u001b[0m\u001b[90m \u001b[0ma.kind\u001b[90m \u001b[0m<>\u001b[90m \u001b[0m\u001b[33m\"MCU-CPU\"\u001b[0m                                                                        \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWITH\u001b[0m\u001b[90m \u001b[0mm,\u001b[90m \u001b[0mop,\u001b[90m \u001b[0mcount(k)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0maccel_kernels                                                            \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWHERE\u001b[0m\u001b[90m \u001b[0maccel_kernels\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[94m0\u001b[0m                                                                          \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mRETURN\u001b[0m\u001b[90m \u001b[0mm.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mmodel,\u001b[90m \u001b[0mm.family\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mfamily,                                                      \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m       \u001b[0mcount(op)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mcpu_only_ops,\u001b[90m \u001b[0m\u001b[94mcollect\u001b[0m(op.name)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0moperators                                  \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mORDER\u001b[0m\u001b[90m \u001b[0m\u001b[94mBY\u001b[0m\u001b[90m \u001b[0mcpu_only_ops\u001b[90m \u001b[0m\u001b[94mDESC\u001b[0m                                                                       \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mLIMIT\u001b[0m\u001b[90m \u001b[0m\u001b[94m10\u001b[0m                                                                                         \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[39.738313, "o", "\u001b[1;35mmodel                      \u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mfamily       \u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mcpu_only_ops\u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35moperators                                 \u001b[0m\r\ndepthwise-cnn-neuro-005      depthwise-cnn  12            ['LpNormalization', 'Round', 'Identity',  \r\n                                                          ...                                       \r\nspectro-cnn-neuro-046        spectro-cnn    11            ['InstanceNormalization',                 \r\n                                                          'ThresholdedRel...                        \r\ntiny-cnn-neuro-042           tiny-cnn       10            ['MaxPool', 'Shape', 'MaxRoiPool',        \r\n                                                          'TopK'...                                 \r\ndepthwise-cnn-mobility-058   depthwise-cnn  10            ['Round', 'DeformConv', 'ConvTranspose',  \r\n                                                          ...                                       \r\nspectro-cnn-respiratory-027  spectro-cnn    10            ['HardSigmoid', 'InstanceNormalization',  \r\n                                                          ...                                       \r\nspectro-cnn-mobility-011     spectro-cnn    9             ['Softplus', 'AveragePool', 'Round',      \r\n                                                          'Def...                                   \r\n"]
