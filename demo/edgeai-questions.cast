[7.033316, "o", "\u001b[1;35moperator       \u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mcategory   \u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mmodels_using\u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mkernel_count\u001b[0m\r\nAtan             elementwise  2             79          \r\nLSTM             recurrent    8             79          \r\nScan             recurrent    8             79          \r\nThresholdedRelu  activation   12            79          \r\nFlatten          shape        5             79          \r\nPad              shape        8             79          \r\n"]
