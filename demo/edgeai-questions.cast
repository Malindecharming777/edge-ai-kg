[42.897398, "o", "\u001b[38;5;59m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(d:Deployment)-[:ON_BOARD]->(b:Board)-[:HAS_SOC]->(s:SoC)                                  \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m      \u001b[0m-[:MADE_BY]->(vendor:Vendor)                                                               \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWHERE\u001b[0m\u001b[90m \u001b[0md.fits\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[94m1\u001b[0m                                                                                 \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mRETURN\u001b[0m\u001b[90m \u001b[0mvendor.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mvendor,\u001b[90m \u001b[0mvendor.country\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mcountry,                                         \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m       \u001b[0mcount(\u001b[94mDISTINCT\u001b[0m\u001b[90m \u001b[0mb)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mboards,\u001b[90m \u001b[0mcount(d)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mdeployments                                      \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mORDER\u001b[0m\u001b[90m \u001b[0m\u001b[94mBY\u001b[0m\u001b[90m \u001b[0mdeployments\u001b[90m \u001b[0m\u001b[94mDESC\u001b[0m                                                                        \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
