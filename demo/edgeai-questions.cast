[9.850503, "o", "\u001b[38;5;59m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(t:ClinicalTask)<-[:SOLVES]-(m:Model)<-[:VARIANT_OF]-(v:ModelVariant)                      \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m      \u001b[0m<-[:OF_VARIANT]-(d:Deployment)-[:ON_BOARD]->(b:Board)                                      \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWHERE\u001b[0m\u001b[90m \u001b[0mt.name\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[33m\"Fall detection\"\u001b[0m\u001b[90m \u001b[0mAND\u001b[90m \u001b[0md.fits\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[94m1\u001b[0m                                                   \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m  \u001b[0mAND\u001b[90m \u001b[0md.latency_ms\u001b[90m \u001b[0m<\u001b[90m \u001b[0mt.latency_budget_ms                                                         \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWITH\u001b[0m\u001b[90m \u001b[0mb.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mboard,\u001b[90m \u001b[0mb.form_factor\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mform,\u001b[90m \u001b[0mb.power_budget_mw\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mpower_mw,                      \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m     \u001b[0mv.precision\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mprecision,\u001b[90m \u001b[0md.latency_ms\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mlatency_ms,                                       \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m     \u001b[0md.fallback_op_count\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mfallback_ops                                                         \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mRETURN\u001b[0m\u001b[90m \u001b[0mboard,\u001b[90m \u001b[0mform,\u001b[90m \u001b[0mpower_mw,\u001b[90m \u001b[0mprecision,\u001b[90m \u001b[0mlatency_ms,\u001b[90m \u001b[0mfallback_ops                                \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mORDER\u001b[0m\u001b[90m \u001b[0m\u001b[94mBY\u001b[0m\u001b[90m \u001b[0mlatency_ms\u001b[90m \u001b[0m\u001b[94mASC\u001b[0m                                                                          \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mLIMIT\u001b[0m\u001b[90m \u001b[0m\u001b[94m12\u001b[0m                                                                                         \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[10.553588, "o", "\u001b[1;35mboard  \u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mform            \u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mpower_mw\u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mprecision\u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mlatency_ms\u001b[0m\u001b[1;35m  \u001b[0m\u001b[1;35mfallback_ops\u001b[0m\r\nCON-253  handheld          250       int4       0.041       5           \r\nVEN-200  som               250       int8       0.056       6           \r\nHAX-217  patch             500       int8       0.066       8           \r\nAKK-210  som               500       int4       0.071       5           \r\nNIK-308  implant-adjacent  30        int4       0.074       6           \r\nCOX-235  wearable-band     2,500     int8       0.097       9           \r\n"]
