[13.459318, "o", "\u001b[38;5;59m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(m:Model)<-[:VARIANT_OF]-(v:ModelVariant)<-[:OF_VARIANT]-(d:Deployment)                    \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m      \u001b[0m-[:ON_BOARD]->(b:Board)                                                                    \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWITH\u001b[0m\u001b[90m \u001b[0mm.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mmodel,\u001b[90m \u001b[0mb.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mboard,\u001b[90m \u001b[0mb.ram_kb\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mboard_ram_kb,                                 \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m     \u001b[0msum(\u001b[94mCASE\u001b[0m\u001b[90m \u001b[0m\u001b[94mWHEN\u001b[0m\u001b[90m \u001b[0mv.precision\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[33m\"fp32\"\u001b[0m\u001b[90m \u001b[0mAND\u001b[90m \u001b[0md.fits\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[94m0\u001b[0m\u001b[90m \u001b[0m\u001b[94mTHEN\u001b[0m\u001b[90m \u001b[0m\u001b[94m1\u001b[0m\u001b[90m \u001b[0mELSE\u001b[90m \u001b[0m\u001b[94m0\u001b[0m\u001b[90m \u001b[0m\u001b[94mEND\u001b[0m)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mfp32_misses,        \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m     \u001b[0msum(\u001b[94mCASE\u001b[0m\u001b[90m \u001b[0m\u001b[94mWHEN\u001b[0m\u001b[90m \u001b[0mv.precision\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[33m\"int8\"\u001b[0m\u001b[90m \u001b[0mAND\u001b[90m \u001b[0md.fits\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[94m1\u001b[0m\u001b[90m \u001b[0m\u001b[94mTHEN\u001b[0m\u001b[90m \u001b[0m\u001b[94m1\u001b[0m\u001b[90m \u001b[0mELSE\u001b[90m \u001b[0m\u001b[94m0\u001b[0m\u001b[90m \u001b[0m\u001b[94mEND\u001b[0m)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mint8_hits,          \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m     \u001b[0mmax(\u001b[94mCASE\u001b[0m\u001b[90m \u001b[0m\u001b[94mWHEN\u001b[0m\u001b[90m \u001b[0mv.precision\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[33m\"fp32\"\u001b[0m\u001b[90m \u001b[0m\u001b[94mTHEN\u001b[0m\u001b[90m \u001b[0mv.size_kb\u001b[90m \u001b[0mELSE\u001b[90m \u001b[0m\u001b[94m0\u001b[0m\u001b[90m \u001b[0m\u001b[94mEND\u001b[0m)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mfp32_kb,                   \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m     \u001b[0mmax(\u001b[94mCASE\u001b[0m\u001b[90m \u001b[0m\u001b[94mWHEN\u001b[0m\u001b[90m \u001b[0mv.precision\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[33m\"int8\"\u001b[0m\u001b[90m \u001b[0m\u001b[94mTHEN\u001b[0m\u001b[90m \u001b[0mv.size_kb\u001b[90m \u001b[0mELSE\u001b[90m \u001b[0m\u001b[94m0\u001b[0m\u001b[90m \u001b[0m\u001b[94mEND\u001b[0m)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mint8_kb,                   \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m     \u001b[0mmin(\u001b[94mCASE\u001b[0m\u001b[90m \u001b[0m\u001b[94mWHEN\u001b[0m\u001b[90m \u001b[0mv.precision\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[33m\"int8\"\u001b[0m\u001b[90m \u001b[0mAND\u001b[90m \u001b[0md.fits\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[94m1\u001b[0m\u001b[90m \u001b[0m\u001b[94mTHEN\u001b[0m\u001b[90m \u001b[0md.latency_ms\u001b[90m \u001b[0mELSE\u001b[90m \u001b[0m\u001b[94m999999\u001b[0m.\u001b[94m0\u001b[0m\u001b[90m \u001b[0m\u001b[94mEND\u001b[0m)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0m  \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m int8_latency_ms                                                                                  \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWHERE\u001b[0m\u001b[90m \u001b[0mfp32_misses\u001b[90m \u001b[0m>\u001b[90m \u001b[0m\u001b[94m0\u001b[0m\u001b[90m \u001b[0mAND\u001b[90m \u001b[0mint8_hits\u001b[90m \u001b[0m>\u001b[90m \u001b[0m\u001b[94m0\u001b[0m                                                          \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mRETURN\u001b[0m\u001b[90m \u001b[0mmodel,\u001b[90m \u001b[0mboard,\u001b[90m \u001b[0mboard_ram_kb,\u001b[90m \u001b[0mfp32_kb,\u001b[90m \u001b[0mint8_kb,\u001b[90m \u001b[0mint8_latency_ms                             \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mORDER\u001b[0m\u001b[90m \u001b[0m\u001b[94mBY\u001b[0m\u001b[90m \u001b[0mfp32_kb\u001b[90m \u001b[0m\u001b[94mDESC\u001b[0m                                                                            \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mLIMIT\u001b[0m\u001b[90m \u001b[0m\u001b[94m12\u001b[0m                                                                                         \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
