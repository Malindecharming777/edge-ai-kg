[24.342107, "o", "\u001b[38;5;59m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(s:Sensor)-[:FEEDS]->(st:SignalStage)-[:NEXT_STAGE*\u001b[94m0\u001b[0m..\u001b[94m3\u001b[0m]->(last:SignalStage)               \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m      \u001b[0m-[:PRECEDES]->(m:Model)<-[:VARIANT_OF]-(v:ModelVariant)                                    \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m      \u001b[0m<-[:OF_VARIANT]-(d:Deployment)-[:ON_BOARD]->(b:Board)                                      \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWHERE\u001b[0m\u001b[90m \u001b[0mv.precision\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[33m\"int8\"\u001b[0m\u001b[90m \u001b[0mAND\u001b[90m \u001b[0md.fits\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[94m1\u001b[0m                                                        \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWITH\u001b[0m\u001b[90m \u001b[0ms.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0msensor,\u001b[90m \u001b[0ms.sample_rate_hz\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mhz,\u001b[90m \u001b[0mlast.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mfinal_stage,                         \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m     \u001b[0mm.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mmodel,\u001b[90m \u001b[0mb.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mboard,\u001b[90m \u001b[0md.latency_ms\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mlatency_ms                                \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mRETURN\u001b[0m\u001b[90m \u001b[0msensor,\u001b[90m \u001b[0mhz,\u001b[90m \u001b[0mfinal_stage,\u001b[90m \u001b[0mmodel,\u