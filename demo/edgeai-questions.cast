[6.214035, "o", "\u001b[38;5;59m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(m:Model)-[:USES_OPERATOR]->(op:Operator)                                                  \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWITH\u001b[0m\u001b[90m \u001b[0mop,\u001b[90m \u001b[0mcount(\u001b[94mDISTINCT\u001b[0m\u001b[90m \u001b[0mm.id)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mmodels_using                                                    \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mOPTIONAL\u001b[0m\u001b[90m \u001b[0m\u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(k:Kernel)-[:IMPLEMENTS]->(op)                                                    \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWITH\u001b[0m\u001b[90m \u001b[0mop,\u001b[90m \u001b[0mmodels_using,\u001b[90m \u001b[0mcount(k)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mkernel_count                                                  \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mRETURN\u001b[0m\u001b[90m \u001b[0mop.name\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0moperator,\u001b[90m \u001b[0mop.category\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0mcategory,                                             \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m       \u001b[0mmodels_using,\u001b[90m \u001b[0mkernel_count                                                                \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mORDER\u001b[0m\u001b[90m \u001b[0m\u001b[94mBY\u001b[0m\u001b[90m \u001b[0mkernel_count\u001b[90m \u001b[0m\u001b[94mASC\u001b[0m                                                                        \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mLIMIT\u001b[0m\u001b[90m \u001b[0