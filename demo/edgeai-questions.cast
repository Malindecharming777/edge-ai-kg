[17.203441, "o", "\u001b[38;5;59m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mMATCH\u001b[0m\u001b[90m \u001b[0m(a:Accelerator)<-[:RUNS_ON]-(k:Kernel)-[:IMPLEMENTS]->(op:Operator)                        \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mWITH\u001b[0m\u001b[90m \u001b[0ma.kind\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0maccelerator_kind,\u001b[90m \u001b[0mcount(\u001b[94mDISTINCT\u001b[0m\u001b[90m \u001b[0mop)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0moperators_covered,                        \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[90m     \u001b[0mcount(\u001b[94mDISTINCT\u001b[0m\u001b[90m \u001b[0ma)\u001b[90m \u001b[0m\u001b[94mAS\u001b[0m\u001b[90m \u001b[0maccelerators                                                           \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mRETURN\u001b[0m\u001b[90m \u001b[0maccelerator_kind,\u001b[90m \u001b[0maccelerators,\u001b[90m \u001b[0moperators_covered                                         \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m│\u001b[0m \u001b[94mORDER\u001b[0m\u001b[90m \u001b[0m\u001b[94mBY\u001b[0m\u001b[90m \u001b[0moperators_covered\u001b[90m \u001b[0m\u001b[94mDESC\u001b[0m                                                                  \u001b[38;5;59m│\u001b[0m\r\n\u001b[38;5;59m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
